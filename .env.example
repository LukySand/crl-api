# Conexión Prisma (adapter MariaDB apuntando al MySQL de docker-compose)
DATABASE_URL="mysql://root:CAMBIAR@localhost:3306/crl_db"

# Credenciales del contenedor MySQL (docker-compose)
MYSQL_ROOT_PASSWORD=CAMBIAR
MYSQL_DATABASE=crl_db

# Usadas por prisma/seed.ts
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CAMBIAR

# Auth
JWT_SECRET=cambiar-esto-en-produccion

# Puerto del API (opcional, default 3001)
PORT=3001

# Carpeta donde se guardan los archivos subidos (opcional).
# Default: uploads/ en la raíz del repo. `:temp:` usa la carpeta temporal del
# sistema, que macOS borra sola — solo para archivos descartables.
# FILES_STORAGE_PATH=/ruta/absoluta/a/uploads

# Tamaño máximo de archivo en MB (opcional, default 10)
# MAX_FILE_SIZE=10
