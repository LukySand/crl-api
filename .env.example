# ── Base de datos ─────────────────────────────────────────────────────────────
# Usá 127.0.0.1, NO localhost: en Mac, Bun resuelve localhost a IPv6, el adapter
# de MariaDB se cuelga 10s y termina fallando con "pool timeout".
#
# allowPublicKeyRetrieval=true hace falta cuando el usuario de MySQL autentica con
# caching_sha2_password (default desde MySQL 8; en MySQL 9 es obligatorio porque
# mysql_native_password fue eliminado). Sin el flag, el adapter se niega a pedirle
# la clave pública al server sobre una conexión sin TLS y el handshake timeoutea.
# Es inofensivo con el MySQL de docker-compose, así que dejalo puesto siempre.
DATABASE_URL="mysql://root:CAMBIAR@127.0.0.1:3306/crl_db?allowPublicKeyRetrieval=true"

# Solo las lee docker-compose.yml para crear el contenedor.
# Si corrés un MySQL local en vez de Docker, ignoralas.
MYSQL_ROOT_PASSWORD=CAMBIAR
MYSQL_DATABASE=crl_db

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=cambiar-esto-en-produccion

# Client ID de Google (Google Identity Services). Sin esto no anda el login con
# Google. El client secret NO se usa: se verifica el ID token, no hay redirect flow.
OAUTH_ID=

# ── Archivos ──────────────────────────────────────────────────────────────────
# Carpeta raíz de las subidas. Vacío o ":temp:" usa <tmp>/crltemp.
FILES_STORAGE_PATH=:temp:

# Tamaño máximo de subida, en MB (default 10).
MAX_FILE_SIZE=10

# URL pública del API. Se usa para armar los links de descarga de archivos.
URL=http://localhost:3001

# ── Server ────────────────────────────────────────────────────────────────────
# Puerto del API (opcional, default 3001).
PORT=3001

# ── Seed ──────────────────────────────────────────────────────────────────────
# En producción se siembran solo los roles. SEED_DEMO=true fuerza los datos demo.
# SEED_DEMO=true
