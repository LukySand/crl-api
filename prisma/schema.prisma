// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider   = "prisma-client"
  output     = "./generated"
  engineType = "client"
  runtime    = "bun"
}

datasource db {
  provider = "mysql"
}

enum RoleType {
  SuperAdmin
  Administrador
  Profesor
  Socio
}

model Role {
  id   Int      @id @default(autoincrement())
  name RoleType @unique

  user_roles UserRole[]

  @@map("roles")
}

// Qué roles tiene cada usuario (M:N): una persona puede ser Profesor y Socio a la
// vez, y los permisos se suman. Reemplazó a `User.role_id`, que admitía uno solo.
model UserRole {
  user_id    String   @db.Char(128)
  role_id    Int
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])
  role Role @relation(fields: [role_id], references: [id])

  @@id([user_id, role_id]) // un rol no se repite en el mismo usuario
  @@map("user_roles")
}

model File {
  id            String   @id @default(uuid())
  name          String   @db.VarChar(255)
  created_at    DateTime
  last_modified DateTime
  etag          Int
  location      String   @db.VarChar(255)
  raw_location  String?  @db.VarChar(255)
  optimized     Boolean  @default(false)
  size          BigInt
  mime          String   @db.VarChar(255)

  users    User[]
  places   Place[]
  payments Payment[] // comprobantes de transferencia

  @@map("files")
}

model User {
  id String @id @default(uuid())

  name            String   @db.VarChar(50)
  last_name       String   @db.VarChar(50)
  dni             String   @db.VarChar(20)
  email           String   @unique @db.VarChar(75)
  celular         String?  @db.VarChar(20)
  password        String   @db.Text
  file_id         String?  @db.Char(128)
  birth_date      DateTime
  active          Boolean  @default(true) // baja lógica: false = dado de baja (#46)
  has_credentials Boolean  @default(true)

  roles UserRole[] // sus roles; los permisos son la suma
  file  File?      @relation(fields: [file_id], references: [id])

  families_as_parent Family[]              @relation("FamilyParent") // hijos a cargo (es el padre/tutor)
  families_as_child  Family[]              @relation("FamilyChild") // vínculos en los que es el hijo
  bookings           Booking[]
  disciplines        DisciplineProfessor[] // disciplinas que dicta (rol Profesor)
  enrollments        Enrollment[] // disciplinas en las que está inscripto (rol Socio)

  // Dos relaciones a Payment, así que van nombradas: una es lo que el usuario
  // debe, la otra los cobros que registró (sólo gestión).
  payments            Payment[]                 @relation("PaymentUser")
  payments_registered Payment[]                 @relation("PaymentRegistrar")
  transactions        PaymentTransaction[]
  recurring_targets   RecurringTemplateTarget[]

  @@map("users")
}

// Vínculo padre/tutor ↔ hijo a cargo. `active` es la dependencia: true = el
// padre lo gestiona/paga desde su cuenta; false = desvinculado
model Family {
  id          String   @id @default(uuid())
  parent_id   String   @db.Char(128)
  child_id    String   @db.Char(128)
  responsible Boolean  @default(false) @db.TinyInt
  active      Boolean  @default(true)
  created_at  DateTime @default(now())

  parent User @relation("FamilyParent", fields: [parent_id], references: [id])
  child  User @relation("FamilyChild", fields: [child_id], references: [id])

  @@unique([parent_id, child_id])
  @@map("families")
}

model Log {
  id          Int      @id @default(autoincrement())
  topic       String
  level       LogLevel
  date        DateTime @default(now())
  text        String
  user_id     Int?
  request_url String?
  data        Json?
  error       String?
  stack_trace String?
  metadata    Json?

  @@map("logs")
}

enum LogLevel {
  DEBUG
  INFO
  ERROR
}

enum BookingStatus {
  Pendiente
  Confirmada
  Cancelada
}

// Clasifica una tarifa (Fee.kind). El concepto de un pago ahora es un String que
// referencia charge_types.key. Un
// solo enum para las dos cosas a propósito: mantiene alineado que un Payment de
// concepto Disciplina apunte a una Fee de disciplina y no a una de cancha.
//
// Hasta ahora Fee no tenía tipo, y como GET /api/fees devuelve todas, nada
// impedía que una disciplina terminara apuntando a "Cancha de fútbol 5 — $12.000".
enum FeeKind {
  Reserva
  Disciplina
  Socio // todavía sin usar: la cuota de socio entra por acá sin migrar nada
}

enum PaymentStatus {
  Pendiente
  EnRevision // el socio subió comprobante, administración todavía no lo confirmó
  Pagado
  Anulado
  Condonado
}

enum PaymentMethod {
  Efectivo
  Transferencia
  MercadoPago
  MPFueraDeApp
  TarjetaConPosnet
}

enum TransactionStatus {
  Pendiente
  Aprobado
  Rechazado
  Cancelado
  Reembolsado
  ReembolsadoParcial
  Contracargo
  Anulado
}

enum DueRule {
  Ninguna
  DiasDesdeEmision
  DiaDelMes
}

enum PeriodMode {
  DiaDelMes
  CadaN
}

enum PeriodUnit {
  Dias
  Semanas
  Meses
}

enum TargetMode {
  Todos
  Disciplina
  Lista
  Socio
}

// ponytail: inmutable — no hay endpoint de update. Cambiar precio = crear una
// fila nueva y repuntar Schedule.fee_id. Así el historial de Booking (que
// guarda su propio fee_id) nunca queda pisado por un cambio de precio.
model Fee {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  amount      Decimal  @db.Decimal(10, 2)
  kind        FeeKind  @default(Reserva) // para qué sirve esta tarifa
  description String?  @db.Text
  created_at  DateTime @default(now())

  schedules   Schedule[]
  bookings    Booking[]
  disciplines Discipline[]
  payments    Payment[]

  @@map("fees")
}

model Place {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(255)
  address     String? @db.VarChar(170)
  capacity    Int?    @db.SmallInt
  description String? @db.Text
  file_id     String? @db.Char(128)
  active      Boolean @default(true) // baja lógica: false = no disponible para reservar

  file        File?           @relation(fields: [file_id], references: [id])
  schedules   Schedule[]
  disciplines Discipline[]
  blocks      ScheduleBlock[]

  @@map("places")
}

// Disciplina del club (fútbol, vóley, patín…): nombre + profesor + cuota + espacio.
// Los días y horas de la clase viven en DisciplineSchedule. Baja lógica como User:
// se desactiva (active=false), no se borra, para no orfanar reservas/horarios.
model Discipline {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(100)
  fee_id   Int? // cuota (Fee); null = sin definir
  place_id Int? // espacio habitual; null = sin definir
  active   Boolean @default(true) // baja lógica: false = dada de baja (#41)
  full     Boolean @default(false) // cupo lleno: lo marca el profe/admin; bloquea nuevas inscripciones (#5)

  // ponytail: DEPRECADO por #6 (varios profes). La fuente de verdad ahora es
  // `professors` (DisciplineProfessor). La columna sigue existiendo sólo para no
  // perder las asignaciones viejas al hacer `db push`: el seed las copia a la
  // tabla nueva. Nada la lee ni la escribe. Borrarla cuando todos hayan corrido
  // el seed una vez (PR de limpieza aparte).
  professor_id String? @db.Char(128)

  created_at DateTime @default(now())

  fee   Fee?   @relation(fields: [fee_id], references: [id])
  place Place? @relation(fields: [place_id], references: [id])

  professors  DisciplineProfessor[] // profes que la dictan (#6)
  enrollments Enrollment[] // socios inscriptos
  schedules   DisciplineSchedule[] // días y horas de la clase
  templates   RecurringTemplate[]

  @@map("disciplines")
}

// Qué profesores dictan cada disciplina (M:N). Reemplaza al viejo
// `Discipline.professor_id`, que sólo admitía uno.
model DisciplineProfessor {
  discipline_id Int
  professor_id  String   @db.Char(128) // User con rol Profesor
  created_at    DateTime @default(now())

  discipline Discipline @relation(fields: [discipline_id], references: [id])
  professor  User       @relation(fields: [professor_id], references: [id])

  @@id([discipline_id, professor_id]) // un profe no se repite en la misma disciplina
  @@map("discipline_professors")
}

// Horario semanal fijo de una disciplina: "vóley los martes de 19:00 a 20:30".
// Es otro modelo que Schedule a propósito: Schedule es el turno reservable de un
// espacio (lleva fee_id y cuelga Booking), la clase no se reserva, se dicta.
model DisciplineSchedule {
  id            Int      @id @default(autoincrement())
  discipline_id Int
  day_of_week   Int      @db.UnsignedTinyInt // 0=domingo … 6=sábado
  start_time    DateTime @db.Time()
  end_time      DateTime @db.Time()
  created_at    DateTime @default(now())

  discipline Discipline @relation(fields: [discipline_id], references: [id])

  @@unique([discipline_id, day_of_week, start_time]) // no dos clases iguales
  @@map("discipline_schedules")
}

// Inscripción de un socio a una disciplina (M:N socio ↔ disciplina), con
// historial de períodos.
// ponytail: mismo truco que Booking — `active` es true mientras el socio cursa
// y null cuando se va. MySQL ignora los null en el unique, así que puede haber
// muchas filas históricas (cada período `created_at`→`left_at`) + una sola
// activa por par socio-disciplina. Salir no borra: setea active=null + left_at.
model Enrollment {
  id            Int       @id @default(autoincrement())
  user_id       String    @db.Char(128) // socio inscripto (UUID, como Booking.user_id)
  discipline_id Int
  created_at    DateTime  @default(now()) // alta del período (desde)
  active        Boolean?  @default(true) // true = cursando; null = se dio de baja
  left_at       DateTime? // baja del período (hasta); null mientras sigue activo

  user       User       @relation(fields: [user_id], references: [id])
  discipline Discipline @relation(fields: [discipline_id], references: [id])
  payments   Payment[] // una cuota por mes cursado

  @@unique([user_id, discipline_id, active]) // una sola inscripción activa por par
  @@map("enrollments")
}

model Schedule {
  id          Int      @id @default(autoincrement())
  place_id    Int
  fee_id      Int
  day_of_week Int      @db.UnsignedTinyInt // 0=domingo … 6=sábado
  start_time  DateTime @db.Time()
  end_time    DateTime @db.Time()

  place    Place     @relation(fields: [place_id], references: [id])
  fee      Fee       @relation(fields: [fee_id], references: [id])
  bookings Booking[]

  @@unique([place_id, day_of_week, start_time])
  @@map("schedules")
}

model Booking {
  id          String        @id @default(uuid())
  schedule_id Int
  fee_id      Int
  user_id     String        @db.Char(128)
  date        DateTime      @db.Date
  status      BookingStatus @default(Pendiente)
  notes       String?       @db.Text
  created_at  DateTime      @default(now())

  // Fin del hold de 5 minutos: sólo lo llevan las reservas pagadas en el acto con MP.
  // NULL = sin plazo propio (la asignada por la gestión vence con el límite para cancelar).
  hold_until DateTime?

  // ponytail: true mientras la reserva está viva (Pendiente/Confirmada), NULL
  // al cancelar. MySQL no soporta índices únicos parciales, pero sí ignora
  // NULL en índices únicos — por eso una reserva cancelada libera el turno
  // sola sin dejar de existir la fila (se conserva el historial). El código
  // que cancela es el único que toca este campo: siempre en el mismo update
  // que pone status = Cancelada, así nunca queda desincronizado.
  active Boolean?

  schedule Schedule @relation(fields: [schedule_id], references: [id])
  fee      Fee      @relation(fields: [fee_id], references: [id])
  user     User     @relation(fields: [user_id], references: [id])
  payment  Payment? // el cobro de esta reserva (1:1)

  @@unique([schedule_id, date, active])
  @@map("bookings")
}

// Una fila = un período adeudado, que además registra cómo se saldó.
// Cubre las reservas de cancha (pago único) y las cuotas de disciplina (mensuales).
//
// ponytail: acá vive tanto la deuda como el cobro a propósito. Separarlo en dos
// tablas (cargo + pago) sólo hace falta para pagos parciales, que el club no
// tiene: se paga la cuota entera o no se paga. Con una sola tabla, "qué debe
// Martín" es un WHERE status = Pendiente y no un LEFT JOIN con sumas.
model Payment {
  id String @id @default(uuid())

  user_id     String  @db.Char(128) // quién debe
  concept     String  @db.VarChar(40) // FK a charge_types.key
  name        String  @db.VarChar(120)
  description String? @db.Text

  // Origen: exactamente uno según el concepto. Reserva → booking_id,
  // Disciplina → enrollment_id, Socio → ninguno de los dos.
  //
  // Apunta a Enrollment y no a Discipline porque la inscripción ya tiene el
  // historial de períodos (created_at → left_at): así se generan cuotas
  // exactamente por los meses que el socio cursó. La disciplina se llega igual
  // navegando enrollment.discipline.
  enrollment_id Int?
  booking_id    String? @unique @db.Char(128) // una reserva = un solo pago

  // ponytail: mismo criterio que Booking.fee_id. `fee_id` es el snapshot de la
  // tarifa y `amount` una copia congelada del monto. Las dos cosas: el snapshot
  // por trazabilidad, la copia porque la inmutabilidad de Fee es una convención
  // (no hay endpoint de update, pero la base no lo impide) y un cobro manual
  // puede no corresponder a ninguna tarifa cargada.
  //
  // Sin la copia, repuntar Discipline.fee_id repreciaría todo el historial: las
  // cuotas de marzo cambiarían de monto porque alguien editó una tarifa en
  // septiembre.
  fee_id Int?
  amount Decimal @db.Decimal(10, 2)

  period   String?   @db.VarChar(10) // "YYYY-MM" en las mensuales; null en las reservas
  due_date DateTime? @db.Date

  // ponytail: no hay estado "Vencido". Se deriva de due_date < hoy con status
  // Pendiente — guardarlo obligaría a un job que a medianoche dé vuelta filas, y
  // el front ya lo trata como presentacional (DueStatus: ok | warn | late).
  status PaymentStatus @default(Pendiente)

  paid_at       DateTime?
  method        PaymentMethod?
  file_id       String?        @db.Char(128) // comprobante de transferencia
  registered_by String?        @db.Char(128) // admin que confirmó el cobro
  notes         String?        @db.Text

  // ponytail: clave de idempotencia. "reserva:<bookingId>",
  // "disciplina:<enrollmentId>:<YYYY-MM>", "socio:<userId>:<YYYY-MM>".
  // Hace que la generación mensual se pueda volver a correr sin duplicar, igual
  // que el seed con sus UUID fijos.
  ref String @unique @db.VarChar(160)

  template_id     Int? // plantilla que lo emitió
  created_by      String?   @db.Char(128) // NULL = motor / sistema
  resolved_by     String?   @db.Char(128) // Anulado/Condonado; "sistema" | "mercadopago"
  resolved_reason String?   @db.Text
  resolved_at     DateTime?
  deleted_at      DateTime? // baja lógica
  deleted_by      String?   @db.Char(128)
  deleted_reason  String?   @db.Text

  created_at DateTime @default(now())

  user       User                     @relation("PaymentUser", fields: [user_id], references: [id])
  registrar  User?                    @relation("PaymentRegistrar", fields: [registered_by], references: [id])
  enrollment Enrollment?              @relation(fields: [enrollment_id], references: [id])
  booking    Booking?                 @relation(fields: [booking_id], references: [id])
  fee        Fee?                     @relation(fields: [fee_id], references: [id])
  file       File?                    @relation(fields: [file_id], references: [id])
  type       ChargeType               @relation(fields: [concept], references: [key])
  template   RecurringTemplate?       @relation(fields: [template_id], references: [id])
  items      PaymentTransactionItem[]
  refunds    Refund[]

  @@index([user_id, status])
  @@index([status, due_date])
  @@index([concept, due_date])
  @@map("payments")
}

// Local adherido con beneficio para socios. La API recorta y valida los textos;
// `active` cambia únicamente mediante baja o reactivación lógica.
model PartnerStore {
  id                   Int     @id @default(autoincrement())
  name                 String  @db.VarChar(100)
  address              String  @db.VarChar(255)
  discount_description String  @db.Text
  active               Boolean @default(true)

  @@map("partner_stores")
}

// Token de la API de Instagram del club. Una sola fila (id = 1). Si no hay token,
// /api/novedades cae a los `NovedadLink` cargados a mano. La API nunca devuelve
// el token completo: solo una máscara.
model InstagramConfig {
  id               Int       @id
  access_token     String?   @db.Text
  token_updated_at DateTime?

  @@map("instagram_config")
}

// Post o reel de Instagram cargado a mano para la vitrina de novedades. `code` es
// el shortcode de la URL (instagram.com/p/<code>/); es único aunque la URL traiga
// parámetros de seguimiento distintos. Orden de la vitrina: fijados, luego `position`.
model NovedadLink {
  id         Int      @id @default(autoincrement())
  code       String   @unique @db.VarChar(50)
  kind       String   @db.VarChar(10)
  pinned     Boolean  @default(false)
  position   Int      @default(0)
  created_at DateTime @default(now())

  @@map("novedad_links")
}

// Bloqueo temporal de un espacio: no se puede reservar en ese rango de fechas (y,
// si trae franja horaria, sólo en esa franja). Es lo que permite cerrar la cancha
// "el lunes 21 por mantenimiento" sin borrar el turno de los lunes, que valdría
// para todos los lunes. Se levanta borrando la fila: es configuración vigente, no
// historial. `created_by` es un id de usuario sin relación a propósito: alcanza
// para saber quién lo puso y no ata el borrado de un usuario a sus bloqueos.
model ScheduleBlock {
  id         Int       @id @default(autoincrement())
  place_id   Int
  date_from  DateTime  @db.Date
  date_to    DateTime  @db.Date // inclusive; igual a date_from si es un solo día
  start_time DateTime? @db.Time() // null = todo el día
  end_time   DateTime? @db.Time()
  reason     String    @db.VarChar(255)
  created_by String    @db.Char(128)
  created_at DateTime  @default(now())

  place Place @relation(fields: [place_id], references: [id])

  @@index([place_id, date_from, date_to])
  @@map("schedule_blocks")
}

// Ajustes del club: una sola fila (id = 1). Lo que antes eran constantes en el código
// —cuánto antes se cancela una reserva, con cuánta anticipación se reserva, el día de
// vencimiento de la cuota—. Sin fila la API usa los valores por defecto de
// `lib/settings.ts`.
// `updated_by` es un id de usuario sin relación, igual que `ScheduleBlock.created_by`.
model ClubSettings {
  id                  Int      @id
  cancel_hours_before Int      @default(10)
  days_ahead_member   Int      @default(21)
  days_ahead_admin    Int      @default(183)
  payment_due_day     Int      @default(10)
  updated_by          String?  @db.Char(128)
  updated_at          DateTime @default(now()) @updatedAt

  @@map("club_settings")
}

model ChargeType {
  id               Int      @id @default(autoincrement())
  key              String   @unique @db.VarChar(40) // inmutable; payments.concept la referencia
  name             String   @db.VarChar(100)
  description      String?  @db.Text
  suggested_amount Decimal? @db.Decimal(10, 2)
  due_rule         DueRule  @default(Ninguna)
  due_value        Int?     @db.UnsignedSmallInt // DiaDelMes NULL => ClubSettings.payment_due_day
  system           Boolean  @default(false) // Reserva, Disciplina, Socio
  active           Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  payments  Payment[]
  templates RecurringTemplate[]

  @@map("charge_types")
}

model RecurringTemplate {
  id            Int         @id @default(autoincrement())
  concept       String      @db.VarChar(40)
  name          String      @db.VarChar(120)
  description   String?     @db.Text
  amount        Decimal?    @db.Decimal(10, 2) // NULL sólo con Disciplina (Fee vigente)
  period_mode   PeriodMode
  day_of_month  Int?        @db.UnsignedTinyInt
  every_n       Int?        @db.UnsignedSmallInt
  unit          PeriodUnit?
  start_date    DateTime    @db.Date
  end_date      DateTime?   @db.Date
  due_rule      DueRule? // NULL = hereda del tipo
  due_value     Int?        @db.UnsignedSmallInt
  target_mode   TargetMode
  discipline_id Int? // Disciplina; NULL = todas
  active        Boolean     @default(true)
  created_by    String      @db.Char(128)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  type       ChargeType                @relation(fields: [concept], references: [key])
  discipline Discipline?               @relation(fields: [discipline_id], references: [id])
  targets    RecurringTemplateTarget[]
  payments   Payment[]

  @@index([active])
  @@map("recurring_templates")
}

// Lista (>=1) y Socio (exactamente 1)
model RecurringTemplateTarget {
  template_id Int
  user_id     String @db.Char(128)

  template RecurringTemplate @relation(fields: [template_id], references: [id])
  user     User              @relation(fields: [user_id], references: [id])

  @@id([template_id, user_id])
  @@index([user_id])
  @@map("recurring_template_targets")
}

model PaymentTransaction {
  id            String            @id @default(uuid()) // external_reference de MP
  user_id       String            @db.Char(128) // quién paga (puede ser el tutor)
  method        PaymentMethod
  status        TransactionStatus @default(Pendiente)
  amount        Decimal           @db.Decimal(10, 2) // suma de items, calculada por el servidor
  registered_by String?           @db.Char(128) // cobro manual
  notes         String?           @db.Text

  mp_payment_id       String?   @unique @db.VarChar(64)
  mp_preference_id    String?   @db.VarChar(64)
  mp_status           String?   @db.VarChar(32)
  mp_status_detail    String?   @db.VarChar(64)
  mp_payment_method   String?   @db.VarChar(32)
  mp_payment_type     String?   @db.VarChar(32)
  mp_fee              Decimal?  @db.Decimal(10, 2)
  net_received_amount Decimal?  @db.Decimal(10, 2)
  mp_last_updated     DateTime?
  checkout_url        String?   @db.VarChar(512) // init_point, para retomar
  raw                 Json?

  paid_at       DateTime?
  expires_at    DateTime?
  voided_by     String?   @db.Char(128)
  voided_reason String?   @db.Text
  voided_at     DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  user    User                     @relation(fields: [user_id], references: [id])
  items   PaymentTransactionItem[]
  refunds Refund[]

  @@index([user_id, status])
  @@index([status, expires_at])
  @@map("payment_transactions")
}

model PaymentTransactionItem {
  transaction_id String
  payment_id     String
  amount         Decimal @db.Decimal(10, 2) // copia de Payment.amount

  transaction PaymentTransaction @relation(fields: [transaction_id], references: [id])
  payment     Payment            @relation(fields: [payment_id], references: [id])

  @@id([transaction_id, payment_id])
  @@index([payment_id])
  @@map("payment_transaction_items")
}

model Refund {
  id              Int       @id @default(autoincrement())
  transaction_id  String
  payment_id      String? // NULL: total por monto inconsistente o externo sin asignar
  amount          Decimal   @db.Decimal(10, 2)
  status          String    @db.VarChar(32) // "pending" | "failed" | "rejected" | "resolved_offline" | estado de MP
  reason          String?   @db.Text
  requested_by    String    @db.Char(128) // id de usuario | "sistema" | "mercadopago"
  income_reversal Boolean   @default(true) // descuenta ingresos en los reportes
  refunded_at     DateTime? // cuándo MP lo aprobó: bucket del egreso
  attempts        Int       @default(0) @db.UnsignedInt
  last_error      String?   @db.VarChar(200)
  resolved_by     String?   @db.Char(128)
  resolved_note   String?   @db.Text
  resolved_at     DateTime?
  mp_refund_id    String?   @unique @db.VarChar(64)
  mp_payment_id   String?   @db.VarChar(64) // pago de MP a devolver; NULL = el `mp_payment_id` de la liquidación (duplicado: otro)
  idempotency_key String    @unique @db.VarChar(160)
  raw             Json?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  transaction PaymentTransaction @relation(fields: [transaction_id], references: [id])
  payment     Payment?           @relation(fields: [payment_id], references: [id])

  @@map("refunds")
}
